      <geom name="bin_wall_east" type="box" size="0.012 0.22 0.09" pos="0.208 0 0.10"
            material="bin_body_mat" contype="1" conaffinity="1" friction="0.8 0.005 0.0001"/>
      <geom name="bin_wall_west" type="box" size="0.012 0.22 0.09" pos="-0.208 0 0.10"
