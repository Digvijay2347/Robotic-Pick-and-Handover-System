      <geom name="bin_rim_west" type="box" size="0.015 0.24 0.02" pos="-0.22 0 0.20" quat="0.9659 0 -0.2588 0"
            material="bin_rim_mat" contype="1" conaffinity="1"/>

      <!-- Center Detection Site inside the bin -->
      <site name="bin_drop_target" pos="0 0 0.08" size="0.01" rgba="0 1 0 0.3"/>
    </body>
  </worldbody>
</mujoco>
