  <!-- Shelf, Storage Bin, and Manipulable Objects -->
  <include file="shelf.xml"/>
  <include file="bin.xml"/>
  <include file="objects.xml"/>

  <!-- ==================== TENDONS ==================== -->
  <tendon>
    <fixed name="arm1_split">
      <joint joint="arm1_right_driver_joint" coef="0.5"/>
      <joint joint="arm1_left_driver_joint" coef="0.5"/>
    </fixed>
    <fixed name="arm2_split">
      <joint joint="arm2_right_driver_joint" coef="0.5"/>
      <joint joint="arm2_left_driver_joint" coef="0.5"/>
    </fixed>
  </tendon>

  <!-- ==================== EQUALITY CONSTRAINTS ==================== -->
  <equality>
    <!-- Arm 1 Gripper Linkages -->
    <connect anchor="0 0 0" body1="arm1_right_follower" body2="arm1_right_coupler" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <connect anchor="0 0 0" body1="arm1_left_follower" body2="arm1_left_coupler" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <joint joint1="arm1_right_driver_joint" joint2="arm1_left_driver_joint" polycoef="0 1 0 0 0" solimp="0.95 0.99 0.001" solref="0.005 1"/>

    <!-- Arm 2 Gripper Linkages -->
    <connect anchor="0 0 0" body1="arm2_right_follower" body2="arm2_right_coupler" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <connect anchor="0 0 0" body1="arm2_left_follower" body2="arm2_left_coupler" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <joint joint1="arm2_right_driver_joint" joint2="arm2_left_driver_joint" polycoef="0 1 0 0 0" solimp="0.95 0.99 0.001" solref="0.005 1"/>
  </equality>

  <!-- ==================== CONTACT EXCLUSIONS ==================== -->
  <contact>
    <!-- Arm 1 Gripper exclusions -->
    <exclude body1="arm1_gripper_base" body2="arm1_left_driver"/>
    <exclude body1="arm1_gripper_base" body2="arm1_right_driver"/>
    <exclude body1="arm1_gripper_base" body2="arm1_left_spring_link"/>
    <exclude body1="arm1_gripper_base" body2="arm1_right_spring_link"/>
    <exclude body1="arm1_right_coupler" body2="arm1_right_follower"/>
    <exclude body1="arm1_left_coupler" body2="arm1_left_follower"/>

    <!-- Arm 2 Gripper exclusions -->
    <exclude body1="arm2_gripper_base" body2="arm2_left_driver"/>
    <exclude body1="arm2_gripper_base" body2="arm2_right_driver"/>
    <exclude body1="arm2_gripper_base" body2="arm2_left_spring_link"/>
    <exclude body1="arm2_gripper_base" body2="arm2_right_spring_link"/>
    <exclude body1="arm2_right_coupler" body2="arm2_right_follower"/>
    <exclude body1="arm2_left_coupler" body2="arm2_left_follower"/>

    <!-- Base & Shoulder exclusions -->
    <exclude body1="arm1_base" body2="arm1_shoulder_link"/>
    <exclude body1="arm2_base" body2="arm2_shoulder_link"/>
  </contact>

  <!-- ==================== ACTUATORS (14-DOF SYSTEM) ==================== -->
  <actuator>
    <!-- Arm 1 UR10e: 6 Joints -->
    <general class="size4" name="arm1_j0_pan" joint="arm1_shoulder_pan_joint"/>
    <general class="size4" name="arm1_j1_lift" joint="arm1_shoulder_lift_joint"/>
    <general class="size3_limited" name="arm1_j2_elbow" joint="arm1_elbow_joint"/>
    <general class="size2" name="arm1_j3_wrist1" joint="arm1_wrist_1_joint"/>
    <general class="size2" name="arm1_j4_wrist2" joint="arm1_wrist_2_joint"/>
    <general class="size2" name="arm1_j5_wrist3" joint="arm1_wrist_3_joint"/>
    <!-- Arm 1 2F-85 Gripper -->
    <general class="2f85" name="arm1_gripper" tendon="arm1_split" forcerange="-15 15" ctrlrange="0 255"
      gainprm="0.3137255 0 0" biasprm="0 -100 -10"/>

    <!-- Arm 2 UR10e: 6 Joints -->
    <general class="size4" name="arm2_j0_pan" joint="arm2_shoulder_pan_joint"/>
    <general class="size4" name="arm2_j1_lift" joint="arm2_shoulder_lift_joint"/>
    <general class="size3_limited" name="arm2_j2_elbow" joint="arm2_elbow_joint"/>
