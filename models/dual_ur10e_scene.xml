    <general class="size2" name="arm2_j4_wrist2" joint="arm2_wrist_2_joint"/>
    <general class="size2" name="arm2_j5_wrist3" joint="arm2_wrist_3_joint"/>
    <!-- Arm 2 2F-85 Gripper -->
    <general class="2f85" name="arm2_gripper" tendon="arm2_split" forcerange="-15 15" ctrlrange="0 255"
      gainprm="0.3137255 0 0" biasprm="0 -100 -10"/>
  </actuator>

