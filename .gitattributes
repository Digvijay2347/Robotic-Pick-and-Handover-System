# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.stl binary
*.obj binary
*.hdf5 binary
*.pt binary
*.pth binary
